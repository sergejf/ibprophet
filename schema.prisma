datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String @id @default(uuid())
  username String

  savedLoadouts SavedLoadout[]
}

model IBSubject {
  id       String          @id @default(uuid())
  name     String          @unique
  group    Int
  category SubjectCategory

  pathwayLinks SubjectPathwayLink[]
}

model UniversityPathway {
  id          String @id @default(uuid())
  name        String @unique
  description String
  field       String

  subjectLinks SubjectPathwayLink[]
  careerLinks  PathwayCareerLink[]
}

model Career {
  id              String       @id @default(uuid())
  name            String       @unique
  slug            String       @unique
  description     String
  salaryStartUS   Int
  salaryMidUS     Int
  salaryStartUK   Int
  salaryMidUK     Int
  growthPercent10Y Float
  aiResilience    AIResilience
  aiExposure            Int?
  aiExposureRationale   String?
  rationaleSource       RationaleSource @default(OWN)
  blsMedianSalaryUS     Int?
  employmentUS          Int?
  projectedGrowthUS     String?
  educationRequired     String?
  blsUrl                String?
  pros            String
  cons            String

  pathwayLinks PathwayCareerLink[]
}

model SubjectPathwayLink {
  id         String @id @default(uuid())
  subjectId  String
  pathwayId  String
  weight     Int    @default(1)
  hlRequired Boolean @default(false)

  subject IBSubject         @relation(fields: [subjectId], references: [id])
  pathway UniversityPathway @relation(fields: [pathwayId], references: [id])

  @@unique([subjectId, pathwayId])
}

model PathwayCareerLink {
  id        String @id @default(uuid())
  pathwayId String
  careerId  String
  weight    Int    @default(1)

  pathway UniversityPathway @relation(fields: [pathwayId], references: [id])
  career  Career            @relation(fields: [careerId], references: [id])

  @@unique([pathwayId, careerId])
}

model SavedLoadout {
  id            String   @id @default(uuid())
  name          String
  subjectConfig String
  createdAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

enum SubjectCategory {
  HL_ONLY
  SL_ONLY
  BOTH
}

/// Provenance for aiExposureRationale. OWN = written for this project;
/// KARPATHY_JOBS = reproduced from github.com/karpathy/jobs (LLM-generated,
/// unlicensed) and surfaced as a quotation rather than presented as our own.
enum RationaleSource {
  OWN
  KARPATHY_JOBS
}

enum AIResilience {
  GREEN
  YELLOW
  RED
}
