# Local development needs NO environment variables.
#
# `wasp start db` launches a Docker-managed Postgres and injects DATABASE_URL
# automatically, so a fresh clone runs with the Setup steps in the README alone.
#
# Copy this file to .env.server only if you need to override a default:
#   cp .env.server.example .env.server

# Point at your own Postgres instead of the one `wasp start db` manages.
# DATABASE_URL=postgresql://user:password@localhost:5432/ibprophet

# Production only. These are set as Fly secrets by `wasp deploy fly`, never
# committed. Listed here so the full runtime surface is documented in one place.
# WASP_WEB_CLIENT_URL=https://ibprophet.app
# WASP_SERVER_URL=https://ibprophet-server.fly.dev
