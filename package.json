{
  "name": "ibprophet",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "dependencies": {
    "@nivo/core": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.69.0",
    "react-router": "^7.12.0",
    "tailwind-merge": "~3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "5.19.1",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.32.1",
    "vite": "^7.0.6",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "prepare": "husky",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write 'src/**/*.{ts,tsx}' '*.{json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' README.md"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
